<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
  bootstrap="vendor/autoload.php"
  colors="true"
  cacheDirectory=".phpunit.cache"
  defaultTestSuite="Unit"
>
  <source>
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
  <testsuites>
    <!-- No infrastructure. Runs on every CI matrix job. -->
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <!-- Needs the `clickhouse` service from compose.yml. -->
    <testsuite name="Integration">
      <directory suffix="Test.php">./tests/Integration</directory>
    </testsuite>
    <!-- Needs compose.cluster.yml: 1 Keeper, 2 shards x 2 replicas. -->
    <testsuite name="Cluster">
      <directory suffix="Test.php">./tests/Cluster</directory>
    </testsuite>
  </testsuites>
  <php>
    <server name="APP_ENV" value="testing"/>
    <server name="CLICKHOUSE_HOST" value="clickhouse"/>
    <server name="CLICKHOUSE_PORT" value="8123"/>
    <server name="CLICKHOUSE_USER" value="test"/>
    <server name="CLICKHOUSE_PASSWORD" value=""/>
    <server name="CLICKHOUSE_DATABASE" value="default"/>
    <server name="CLICKHOUSE_CLUSTER_NAME" value="main"/>
    <server name="CLICKHOUSE_CLUSTER_NODES" value="clickhouse-s1r1,clickhouse-s1r2,clickhouse-s2r1,clickhouse-s2r2"/>
  </php>
</phpunit>
